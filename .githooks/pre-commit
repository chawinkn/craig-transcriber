#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACM -- '*.py' 'static/*.js' 'static/*.css')
[ ${#files[@]} -gt 0 ] || exit 0

bash scripts/check.sh --fix "${files[@]}"
git add -- "${files[@]}"
